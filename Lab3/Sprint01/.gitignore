# Token de acesso do GitHub - NUNCA deve ser versionado
.env

# Dependencias (o projeto nao usa nenhuma, mas fica a protecao)
node_modules/

# Cache das respostas brutas da API (um JSON por requisicao; pode ser grande).
# Os resultados da coleta (data/raw/ e data/processed/) SAO versionados, para
# que os demais integrantes e o grupo replicador partam da mesma amostra.
data/cache/

# O CSV de workflow runs (uma linha por execucao de CI) passa de 250 MB na
# coleta completa, acima do limite de 100 MB por arquivo do GitHub. O que vai
# versionado e' a versao compactada (workflow_runs.csv.gz, ~21 MB); para
# descompactar: gzip -d -k data/processed/workflow_runs.csv.gz
data/processed/workflow_runs.csv

# Planilha de rotulagem em HTML: e' uma FERRAMENTA, gerada de rotulos_<nome>.csv
# por scripts/planilha-rotulagem.mjs. Nao e' dado e nao precisa ser versionada
# (sao ~225 KB por avaliador, so' com o que ja esta no CSV).
data/processed/rotulagem_*.html
