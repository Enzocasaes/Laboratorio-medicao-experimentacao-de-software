{
  "name": "lab03-metricas-dora",
  "version": "0.1.0",
  "description": "Laboratorio 03 - Mineracao de metricas DORA (pipeline de coleta via API REST do GitHub)",
  "type": "module",
  "main": "src/pipeline.js",
  "scripts": {
    "pipeline": "node src/pipeline.js --config config.json",
    "coletar:repositorios": "node src/pipeline.js --config config.json --etapa repositorios",
    "coletar:releases": "node src/pipeline.js --config config.json --etapa releases",
    "coletar:leadtime": "node src/pipeline.js --config config.json --etapa leadtime",
    "corretiva": "node src/pipeline.js --config config.json --etapa corretiva",
    "coletar:runs": "node src/pipeline.js --config config.json --etapa runs",
    "dataset": "node src/pipeline.js --config config.json --etapa dataset",
    "analise:dora": "node src/pipeline.js --config config.json --etapa analise",
    "analise:rq05": "node src/pipeline.js --config config.json --etapa rq05",
    "analise:rq06": "node src/pipeline.js --config config.json --etapa rq06",
    "analise:rq08": "node src/pipeline.js --config config.json --etapa rq08",
    "amostra:ouro": "node src/validacao/amostra-ouro.js --config config.json",
    "validacao": "node src/validacao/index.js --config config.json",
    "test": "node --test test/*.test.js",
    "test:cobertura": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-exclude=src/env.js --test-coverage-lines=80 test/*.test.js"
  },
  "engines": {
    "node": ">=22.8.0"
  },
  "license": "MIT"
}
